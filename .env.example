# --- App (Expo) — safe to use in the client bundle for EXPO_PUBLIC_* only ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use one of these (Dashboard may label the publishable key as EXPO_PUBLIC_SUPABASE_KEY):
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Expo push access token for production broadcast sends (expo.dev → Project → Credentials)
# EXPO_PUBLIC_EXPO_ACCESS_TOKEN=

# Optional: path to google-services.json when using EAS file env (see npm run fcm:setup)
# GOOGLE_SERVICES_JSON=./google-services.json

# Optional: push auth email templates to hosted Supabase (npm run email:apply)
# Optional: push auth redirect URLs to hosted Supabase (npm run auth:apply)
# Optional: push Apple provider config to hosted Supabase (npm run apple:apply)
# SUPABASE_ACCESS_TOKEN=your_personal_access_token
# SUPABASE_AUTH_SITE_URL=vinylhead://

# --- Sign in with Apple (server/scripts only — never bundle into the app) ---
# Services ID for web/Android OAuth (e.g. com.bilguun88.vinylheadapp.web)
# APPLE_CLIENT_ID=com.bilguun88.vinylheadapp.web
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# Easiest: point at the downloaded .p8 file (keep it out of git — add *.p8 to .gitignore)
# APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# Or inline PEM (escape newlines as \n):
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional comma-separated Client IDs sent to Supabase (bundle + Services + Expo Go):
# APPLE_CLIENT_IDS=com.bilguun88.vinylheadapp,com.bilguun88.vinylheadapp.web,host.exp.Exponent

# Optional: override password-reset redirect on web/production builds
# EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=https://your-domain.com/reset-password

# Public privacy policy URL (profile, login, sign-up, App Store Connect)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://bilguun2004.github.io/VinylHeadApp/privacy/

# --- Database push (npm run db:apply) — NOT bundled into the app; never commit real values ---
# Easiest (recommended): paste full Session URI from Dashboard → Connect.
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
#
# Or password only (script auto-finds pooler host; may take ~30s):
# SUPABASE_DB_PASSWORD=your_database_password
# Optional if auto-detect fails — copy host from the Session URI above:
# SUPABASE_POOLER_HOST=aws-1-ap-northeast-1.pooler.supabase.com
