# --- App (Expo) — safe to use in the client bundle for EXPO_PUBLIC_* only ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use one of these (Dashboard may label the publishable key as EXPO_PUBLIC_SUPABASE_KEY):
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Expo push access token for production broadcast sends (expo.dev → Project → Credentials)
# EXPO_PUBLIC_EXPO_ACCESS_TOKEN=

# Optional: path to google-services.json when using EAS file env (see npm run fcm:setup)
# GOOGLE_SERVICES_JSON=./google-services.json

# Optional: push auth email templates to hosted Supabase (npm run email:apply)
# SUPABASE_ACCESS_TOKEN=your_personal_access_token

# --- Database push (npm run db:apply) — NOT bundled into the app; never commit real values ---
# Easiest (recommended): paste full Session URI from Dashboard → Connect.
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
#
# Or password only (script auto-finds pooler host; may take ~30s):
# SUPABASE_DB_PASSWORD=your_database_password
# Optional if auto-detect fails — copy host from the Session URI above:
# SUPABASE_POOLER_HOST=aws-1-ap-northeast-1.pooler.supabase.com
