    "db:apply:notifications": "node scripts/apply-schema.cjs --only 20260525120000_broadcast_notifications.sql",
    "db:apply:order-uploads": "node scripts/apply-schema.cjs --only 20260526120000_order_uploads_storage.sql",
    "db:apply:sub-categories": "node scripts/apply-schema.cjs --only 20260527120000_sub_categories.sql",
